{
  "name": "codex_switch",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "version:sync": "node scripts/version-sync.mjs",
    "version:sync:release": "node scripts/version-sync.mjs --set-from-version-log src-tauri/target/release/version.md",
    "version:set": "node scripts/version-sync.mjs --set",
    "version:check": "node scripts/version-sync.mjs --check",
    "check:windows-release-hygiene": "node scripts/check-windows-release-hygiene.mjs",
    "build": "npm run version:sync && tsc && vite build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:front": "vitest run --root .",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:windows-gnu": "node scripts/verify-windows-gnu-tests.mjs",
    "check:rust:windows": "node scripts/cargo-windows-msvc.mjs check --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc --lib",
    "test:rust:windows": "node scripts/cargo-windows-msvc.mjs test --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc",
    "tauri": "tauri",
    "tauri:dev": "npm run version:sync && tauri dev",
    "tauri:build": "npm run tauri:build:windows",
    "tauri:build:windows": "npm run version:sync:release && tauri build --target x86_64-pc-windows-msvc",
    "deploy:windows:remote-desktop": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-remote-windows-desktop.ps1",
    "tauri:build:portable": "npm run tauri:build:windows:portable",
    "tauri:build:windows:portable": "npm run version:sync && node scripts/tauri-windows-msvc-build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
